# Copy to .env on the server and fill in. Never commit real values.

# Proton VPN WireGuard config values from account.protonvpn.com → Downloads → WireGuard.
# Prefer a dedicated config/profile for this Memoza worker.
WIREGUARD_PRIVATE_KEY=replace_me
WIREGUARD_ADDRESSES=10.2.0.2/32

# Narrow the exit selection at first. Examples: Poland, Netherlands, Germany, United States
SERVER_COUNTRIES=Poland

# Optional: make the worker visible locally only through this port if it exposes HTTP later.
SOCIAL_WORKER_PORT=127.0.0.1:8091
